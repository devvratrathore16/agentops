# Copy/merge into a local .env for development. Values below are placeholders.
POSTGRES_DB=agentops
POSTGRES_USER=agentops
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5433
REDIS_PORT=6379

# API configuration. Keep .env local; replace placeholder values for your environment.
DATABASE_URL=postgresql+psycopg://agentops:change-me-local-only@localhost:5433/agentops
APP_ENV=development
ALLOWED_ORIGINS='["http://localhost:3000"]'
LOG_LEVEL=INFO
APP_SECRET_KEY=replace-with-a-random-secret-before-authentication-is-enabled
SESSION_COOKIE_NAME=agentops_session
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=false
API_KEY_HEADER_NAME=Authorization
